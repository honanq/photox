			<string>enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.simon.hidden-album</string>
			<key>PostNotification</key>
			<string>com.simon.hidden-album/changed</string>
		</dict>
	</array>
</dict>
</plist>
